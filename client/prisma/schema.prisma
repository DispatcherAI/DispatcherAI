generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String     @id @default(cuid())
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @default(now()) @updatedAt
  clerkUserId String?    @unique
  email       String?    @unique
  name        String?
  phone       String?
  userModel   String?
  userPrompt  String?
  callId      String?
  calls       UserCall[]
}

model Call {
  id        String       @id @default(cuid())
  type      callType
  createdAt DateTime     @default(now())
  endedAt   DateTime?
  duration  Int?
  severity  severityType
  status    statusType
  userId    String?
  waitTime  Int?
  messages  Message[]
  users     UserCall[]
}

model Message {
  id        String      @id @default(cuid())
  createdAt DateTime    @default(now())
  role      messageRole
  content   String
  callId    String
  call      Call        @relation(fields: [callId], references: [id])
}

model UserCall {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  userId    String
  callId    String
  call      Call     @relation(fields: [callId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
}

enum callType {
  Fire
  Medical
  Flood
  Robbery
  Critical
}

enum severityType {
  Low
  Medium
  High
  Critical
}

enum statusType {
  Active
  Resolved
}

enum messageRole {
  DISPATCHER
  CALLER
}
