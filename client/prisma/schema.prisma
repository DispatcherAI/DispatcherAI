generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  clerkUserId String?  @unique
  email       String?  @unique
  name        String?
  phone       String?
  Call        Call[]
  // user specified AI model and prompt to use
  userModel  String?
  userPrompt String?
}

model Call {
  id        String       @id @default(cuid())
  type      callType
  createdAt DateTime     @default(now())
  endedAt   DateTime?
  duration  Int?
  severity  severityType
  status    statusType
  userId    String?
  waitTime  Int?
  User      User?        @relation(fields: [userId], references: [id])
}

enum callType {
  Fire
  Medical
  Flood
  Robbery
  Critical
}

enum severityType {
  Low
  Medium
  High
  Critical
}

enum statusType {
  Active
  Resolved
}
