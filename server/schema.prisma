generator client {
  provider = "prisma-client-py"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum callType {
  Fire
  Medical
  Police
}

enum severityType {
  Low
  Medium
  High
  Critical
}

enum statusType {
  Active
  Resolved
}

model User {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  clerkUserId String?  @unique
  email       String?  @unique
  phoneNumber String?  @unique
  credits     Int      @default(50)

  calls Call[]
}

model Call {
  id         String     @id @default(cuid())
  createdAt  DateTime   @default(now())
  endedAt    DateTime?
  inProgress Boolean?
  status     statusType
  userId     String?
  user       User?      @relation(fields: [userId], references: [id])
  transcript Json? // Store entire conversation JSON here

  // Make CallAnalytics a single record, optional or required (your choice)
  callAnalytics CallAnalytics?
}

model CallAnalytics {
  id     String @id @default(cuid())
  callId String @unique // ensure only one CallAnalytics per Call
  call   Call?  @relation(fields: [callId], references: [id])

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @default(now()) @updatedAt
  type           callType?
  severity       severityType?
  summary        String?
  sentiment      Json?
  topics         String[]
  location       String?
  latitude       Float?
  longitude      Float?
  title          String?
  name           String?
  address        String?
  recommendation String?
  streetView     String?

  @@index([callId])
}
